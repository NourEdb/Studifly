VITE_API_URL=http://localhost:5000/api

# Base URL for the Socket.IO connection (no /api suffix, no trailing slash).
# Leave unset for local dev — the Vite dev proxy (vite.config.js) forwards
# /socket.io to localhost:5000 automatically.
# REQUIRED in production (e.g. Vercel): the frontend and backend are on
# different domains there (Vercel vs Render), so there is no dev proxy to fall
# back on — without this set, the socket silently connects to the frontend's
# own origin instead of the backend, and nothing real-time will work.
# Example: VITE_SOCKET_URL=https://studifly-backend.onrender.com
VITE_SOCKET_URL=
