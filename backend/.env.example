PORT=5000
JWT_SECRET=change_this_to_a_long_random_string
DATABASE_URL=postgresql://user:password@host/dbname
FRONTEND_URL=http://localhost:5173
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b

# --- Email delivery ---
# Production (Render free tier blocks outbound SMTP ports 25/465/587, so
# nodemailer over Gmail cannot work there). Set BREVO_API_KEY and all email is
# sent over Brevo's HTTPS API instead; leave it unset and SMTP is used.
BREVO_API_KEY=xkeysib-...
# Must be a sender address verified in Brevo. "Name <addr>" also accepted.
EMAIL_FROM=Studifly <you@gmail.com>

# Local development fallback, used only when BREVO_API_KEY is unset.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- Scheduled jobs ---
# Shared secret for POST /api/jobs/reminders and POST /api/jobs/weekly-review,
# which GitHub Actions calls on a schedule because a sleeping free instance
# cannot run its own cron. Must match the CRON_SECRET GitHub repository secret.
CRON_SECRET=change_this_to_a_long_random_string

# Off by default. Every local backend points at the SAME shared production
# database (there's no per-developer dev database) — leaving the in-process
# reminder/weekly-review cron on would email real users just by having the
# server running on your laptop. Set to "true" only if you deliberately want
# to exercise the local schedules; otherwise test by calling
# POST /api/jobs/reminders or POST /api/jobs/weekly-review directly.
ENABLE_LOCAL_CRON=false
